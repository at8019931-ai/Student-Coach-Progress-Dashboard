# Copy this file to .env.local and fill in your values
# ─────────────────────────────────────────────────────────────

# ─── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── PostgreSQL (direct connection) ──────────────────────────
# Connection string for the CircleChess PostgreSQL database
CC_DATABASE_URL=postgresql://user:password@host:5432/dbname
# Set to "true" if your hosted DB requires SSL (e.g. Neon, Supabase, Railway)
CC_DATABASE_SSL=false

# ─── Anthropic Claude API ─────────────────────────────────────
# Get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Google Service Account ───────────────────────────────────
# Create a Service Account in Google Cloud Console with access to:
#   • Google Drive API  (read-only)
#   • Google Sheets API (read-only)
# Download the JSON key and extract these values:
GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Paste the private_key value from the JSON key — keep \n literal newlines
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEo...\n-----END RSA PRIVATE KEY-----\n"

# ─── Google Form / Sheet IDs ──────────────────────────────────
# The Google Spreadsheet ID linked to your Coach Profile Google Form
# Found in the Sheet URL: docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_FORMS_SPREADSHEET_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms

# The Google Drive folder ID where coaches upload their photos
# Found in the Drive folder URL: drive.google.com/drive/folders/FOLDER_ID
GOOGLE_DRIVE_FOLDER_ID=1A2B3C4D5E6F7G8H9I0J

# ─── Webhook secret ───────────────────────────────────────────
# Shared secret between your Next.js app and the Google Apps Script trigger.
# Use a long random string: openssl rand -hex 32
WEBHOOK_SECRET=change-me-to-a-long-random-secret-string

# ─── Supabase (legacy — only needed for auth if still used) ───
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Email notifications (optional) ──────────────────────────
# RESEND_API_KEY=re_xxxxxxxxxxxxx
# ADMIN_EMAIL=admin@yourcirclechess.com
